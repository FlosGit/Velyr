# ============================================================
# Velyr Growth Agent – Environment Variables
# Copy to .env.local for development
# Add all to Vercel project settings for production
# ============================================================

# ── Supabase (already have these) ───────────────────────────
# The frontend is Vite: it exposes ONLY VITE_-prefixed vars to the browser, so these
# VITE_* vars are authoritative for the client (browser Supabase client + direct Edge
# Function calls like shopify-oauth). Set them in Vercel for Production.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# Legacy NEXT_PUBLIC_* (from the old Next.js scaffold) — a code-level fallback only; a
# Vite build does NOT expose these to the browser. Keep in sync if you set them at all.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # NEVER expose to browser

# ── OpenRouter (already have this) ──────────────────────────
OPENROUTER_API_KEY=sk-or-...

# ── Google PageSpeed (free, optional but recommended) ────────
GOOGLE_PAGESPEED_API_KEY=AIza...
# Get at: https://console.cloud.google.com → PageSpeed Insights API

# ── GitHub App ───────────────────────────────────────────────
# Create at: https://github.com/settings/apps/new
# Permissions needed: Contents (R/W), Pull requests (R/W), Metadata (R)
# Webhook: subscribe to "Pull requests" events → POST /api/webhooks/github
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY_BASE64=LS0t...   # base64 of the .pem file
# openssl base64 -in private-key.pem | tr -d '\n'
# OAuth credentials of the GitHub App (Settings → General → Client secrets).
# The code reads GITHUB_OAUTH_* — the un-prefixed GITHUB_CLIENT_ID/SECRET names
# that used to sit here were never read by anything (broken-onboarding trap).
GITHUB_OAUTH_CLIENT_ID=Iv1.abc...
GITHUB_OAUTH_CLIENT_SECRET=abc...
# HMAC key for the signed OAuth `state` token + the onboarding handoff cookie
# (api/github/_oauth-state.js). Required — onboarding fails without it.
GITHUB_OAUTH_STATE_SECRET=generate-random-32-char-string
# Webhook secret configured in the GitHub App settings; verifies x-hub-signature-256
GITHUB_WEBHOOK_SECRET=generate-random-32-char-string

# ── Telegram Bot ─────────────────────────────────────────────
# Create bot: message @BotFather → /newbot
# Set webhook after deploy:
# curl -X POST https://api.telegram.org/bot{TOKEN}/setWebhook \
#   -H "Content-Type: application/json" \
#   -d '{"url":"https://your-domain.com/api/webhooks/telegram","secret_token":"your-secret"}'
TELEGRAM_BOT_TOKEN=123456789:AAF...
TELEGRAM_WEBHOOK_SECRET=generate-random-32-char-string

# ── Mailjet (lifecycle emails: welcome / day-2+7 drip / weekly digest) ──
# Vercel-only — the Supabase edge fn never sends email, so no Deno twin exists.
# All sends are fixed templates (api/_lib/email.js), never LLM output, with
# open/click tracking force-disabled. Skipped silently (console warning) if
# unset. Sends ALSO require AGENT_APPROVAL_TOKEN_SECRET (signs the one-click
# unsubscribe links — rotating that secret kills every already-sent link).
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
# Optional sender override; defaults to info@velyr.io. Must be a verified
# sender address/domain in the Mailjet account (SPF/DKIM).
EMAIL_FROM_ADDRESS=

# ── Stripe ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Single product: the €49/mo Growth subscription (Stripe Dashboard → Products).
# Pre-2026-07-15 paying subscribers stay grandfathered on the old €29 Price
# object — that object needs no env var (it lives on their subscription).
STRIPE_PRICE_GROWTH=price_...

# ── Security ─────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_TOKEN_ENCRYPTION_KEY=64-hex-chars-for-aes-256
AGENT_APPROVAL_TOKEN_SECRET=32-hex-chars-for-hmac
AGENT_CRON_SECRET=32-hex-chars-for-cron-auth

# ── ScreenshotOne (Growth Agent before/after screenshots) ──
# Used by the Growth Agent to capture before/after screenshots of pages
# being modified. Surfaced in the Telegram message and public timeline.
# Skipped gracefully (with a console warning) if unset.
# Sign up at: https://screenshotone.com → Dashboard → API access keys
SCREENSHOTONE_API_KEY=

# ── C3: Shopify-direct preview themes (default OFF) ─────────
# =1 adds a 🔍 Preview button to Shopify-direct approvals: the pending fix is
# staged onto a throwaway DUPLICATE theme (?preview_theme_id link), deleted when
# the merchant decides. Set on BOTH Vercel (webhook executes it) and the Supabase
# edge fn (shows the button). Enable ONLY after scripts/shopify-dv-verify.mjs
# steps (5)+(6) pass on a dev store — themeDuplicate/themeDelete are Admin API
# 2026-07 shapes and need the write_themes exemption.
AGENT_SHOPIFY_PREVIEW_THEMES=

# ── PostHog (server-side reads; shared project, $host-partitioned) ──
POSTHOG_API_KEY=phx_...          # personal/project API key for queries
POSTHOG_PROJECT_ID=412701        # the ONE shared project (all customers)
POSTHOG_HOST=https://us.posthog.com
# Optional: the shared public write token handed to customers in the snippet;
# defaults to the phc_… token in index.html if unset.
POSTHOG_PROJECT_TOKEN=

# ── Telegram default chat (operator alerts without a bound customer chat) ──
TELEGRAM_CHAT_ID=

# ── Agent LLM (also set as Supabase secrets for the edge fn — BOTH surfaces) ──
# Production: anthropic/claude-opus-4.8 (OpenRouter slugs use a DOT, not a dash).
# Re-check LLM_INPUT_EUR_PER_M / LLM_OUTPUT_EUR_PER_M when switching models.
AGENT_LLM_MODEL=

# ── Bing Webmaster Tools URL Submission API (SEO; build-time only) ──
# SECRET. Not the same thing as the IndexNow key: the IndexNow key is public by
# design (served at /a8425d52….txt), this one authenticates against the velyr.io
# property in Bing Webmaster Tools. Get it at Bing Webmaster Tools > Settings >
# API Access > API Key. Read by scripts/lib/bing-url-submission.mjs during the
# prerender step of `npm run build`, so it must be set on VERCEL (build env) to
# have any effect on deploys. Unset = the submission is skipped silently.
# Verify a key without a full build:
#   BING_WEBMASTER_API_KEY=… node scripts/lib/bing-url-submission.mjs --quota
BING_WEBMASTER_API_KEY=
# Optional origin override; defaults to https://velyr.io. Must exactly match the
# verified property in Bing Webmaster Tools (protocol and www included).
BING_SITE_URL=
